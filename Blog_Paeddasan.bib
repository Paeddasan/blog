@article{pereiraPrimingExercisesTheir2025,
  title = {Priming {{Exercises}} and {{Their Potential Impact}} on {{Speed}} and {{Power Performance}}: {{A Narrative Review}}},
  shorttitle = {Priming {{Exercises}} and {{Their Potential Impact}} on {{Speed}} and {{Power Performance}}},
  author = {Pereira, Lucas A. and Zmijewski, Piotr and Golas, Artur and Kotula, Krzysztof and McGuigan, Michael R. and Loturco, Irineu},
